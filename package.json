{
	"name": "brickverse-installer",
	"version": "1.1.2",
	"description": "Cross-platform installer and updater for the BrickVerse Client and Creator.",
	"main": "dist/main/main.js",
	"desktopName": "gg.brickverse.installer.desktop",
	"author": {
		"name": "Meta Games LLC",
		"email": "support@brickverse.gg",
		"url": "https://brickverse.gg"
	},
	"license": "MIT",
	"private": true,
	"scripts": {
		"clean": "rimraf dist release",
		"typecheck": "tsc --noEmit",
		"build": "npm run clean && tsc && vite build",
		"dev": "concurrently -k \"vite\" \"tsc -w -p tsconfig.main.json\" \"wait-on tcp:5173 file:dist/main/main.js && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
		"start": "electron .",
		"pack": "npm run build && electron-builder --dir --publish never",
		"dist": "npm run build && electron-builder --publish never",
		"dist:win": "npm run build && electron-builder --win nsis --publish never",
		"dist:mac": "npm run build && electron-builder --mac dmg zip --universal --publish never",
		"dist:linux": "npm run build && electron-builder --linux AppImage deb --publish never",
		"release": "npm run build && electron-builder --publish always"
	},
	"dependencies": {
		"adm-zip": "^0.5.16",
		"electron-updater": "^6.6.2"
	},
	"devDependencies": {
		"@types/adm-zip": "^0.5.7",
		"@types/node": "^24.0.0",
		"@vitejs/plugin-react": "^4.6.0",
		"concurrently": "^9.2.0",
		"cross-env": "^7.0.3",
		"electron": "^37.2.0",
		"electron-builder": "^26.0.12",
		"rimraf": "^6.0.1",
		"typescript": "^5.8.3",
		"vite": "^7.0.0",
		"wait-on": "^8.0.3",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"@types/react": "^19.1.0",
		"@types/react-dom": "^19.1.0"
	},
	"build": {
		"appId": "gg.brickverse.installer",
		"productName": "BrickVerse Installer",
		"asar": true,
		"directories": {
			"output": "release",
			"buildResources": "build"
		},
		"files": [
			"dist/**/*",
			"package.json"
		],
		"extraMetadata": {
			"main": "dist/main/main.js"
		},
		"publish": {
			"provider": "github",
			"owner": "BrickVerse-co",
			"repo": "installer",
			"releaseType": "release"
		},
		"protocols": [
			{
				"name": "BrickVerse",
				"schemes": [
					"brickverse"
				]
			}
		],
		"fileAssociations": [
			{
				"ext": [
					"bvxl",
					"bvproject"
				],
				"name": "BrickVerse Project",
				"description": "BrickVerse Creator project",
				"role": "Editor"
			},
			{
				"ext": [
					"bvxw",
					"bvworld"
				],
				"name": "BrickVerse World",
				"description": "BrickVerse world",
				"role": "Editor"
			},
			{
				"ext": [
					"bvxm",
					"bvmodel",
					"model"
				],
				"name": "BrickVerse Model",
				"description": "BrickVerse model or prefab",
				"role": "Editor"
			},
			{
				"ext": "bvanim",
				"name": "BrickVerse Animation",
				"description": "BrickVerse animation",
				"role": "Editor"
			},
			{
				"ext": "bvaddon",
				"name": "BrickVerse Addon",
				"description": "BrickVerse Creator addon",
				"role": "Editor"
			}
		],
		"win": {
			"icon": "build/icon.ico",
			"target": [
				{
					"target": "nsis",
					"arch": [
						"x64"
					]
				}
			],
			"artifactName": "BrickVerse-Installer-${version}-${arch}.${ext}"
		},
		"nsis": {
			"installerIcon": "build/icon.ico",
			"uninstallerIcon": "build/icon.ico",
			"oneClick": false,
			"allowElevation": true,
			"allowToChangeInstallationDirectory": true,
			"perMachine": false,
			"createDesktopShortcut": true,
			"createStartMenuShortcut": true,
			"shortcutName": "BrickVerse Installer",
			"runAfterFinish": true,
			"deleteAppDataOnUninstall": false
		},
		"mac": {
			"icon": "build/icon.icns",
			"target": [
				{
					"target": "dmg",
					"arch": [
						"universal"
					]
				},
				{
					"target": "zip",
					"arch": [
						"universal"
					]
				}
			],
			"category": "public.app-category.utilities",
			"artifactName": "BrickVerse-Installer-${version}-${arch}.${ext}",
			"identity": null,
			"hardenedRuntime": false,
			"gatekeeperAssess": false
		},
		"dmg": {
			"title": "BrickVerse Installer ${version}",
			"icon": "build/icon.icns",
			"iconSize": 96,
			"contents": [
				{
					"x": 140,
					"y": 220,
					"type": "file"
				},
				{
					"x": 400,
					"y": 220,
					"type": "link",
					"path": "/Applications"
				}
			]
		},
		"linux": {
			"icon": "build/icons",
			"target": [
				{
					"target": "AppImage",
					"arch": [
						"x64",
						"arm64"
					]
				},
				{
					"target": "deb",
					"arch": [
						"x64",
						"arm64"
					]
				}
			],
			"category": "Utility",
			"maintainer": "Meta Games LLC <support@brickverse.gg>",
			"vendor": "Meta Games LLC",
			"synopsis": "Installer for BrickVerse Client and Creator",
			"description": "Installs and updates BrickVerse Client and BrickVerse Creator.",
			"syncDesktopName": true,
			"artifactName": "BrickVerse-Installer-${version}-${arch}.${ext}"
		}
	}
}
